# Neon Postgres connection string (required)
DATABASE_URL=

# Anthropic API key (optional — without it, task extraction falls back to a
# simple heuristic instead of Claude)
ANTHROPIC_API_KEY=

# Model used to structure voice notes. Defaults to claude-opus-4-8.
# Set to claude-haiku-4-5 for a cheaper/faster option.
ANTHROPIC_MODEL=

# IANA timezone used to decide what "today" means (defaults to America/Chicago)
APP_TIMEZONE=America/Chicago
