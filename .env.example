# VoiceTaskFlow Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (optional for demo mode)
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to run in demo mode with mock AI responses
OPENAI_API_KEY=

# Server port (optional, defaults to 5000)
PORT=5000

# Database URL (optional - app uses in-memory storage by default)
# Only needed if you want persistent storage with PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/voicetaskflow
